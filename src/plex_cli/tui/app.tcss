Screen {
    background: $background;
}

#body {
    height: 1fr;
}

/* ---- sidebar ---------------------------------------------------------- */

#sidebar {
    width: 36;
    height: 1fr;
    background: $surface;
    border-right: tall $panel;
    padding: 1 0 0 0;
}

#sidebar-title {
    padding: 0 2 1 2;
}

#sessions {
    height: 1fr;
    border: none;
    background: $surface;
    padding: 0 1;
}

#sessions > .option-list--option {
    padding: 0 1;
    margin-bottom: 1;
}

#sessions:focus {
    border: none;
}

/* ---- chat ------------------------------------------------------------- */

#main {
    height: 1fr;
}

#chat {
    width: 100%;  /* not 1fr: Textual sizes fr widths net of the widest sibling margin (#statusbar 3+4) */
    height: 1fr;
    padding: 1 3 0 3;
    scrollbar-size-vertical: 1;
    scrollbar-color: $panel;
    scrollbar-background: $background;
}

#welcome {
    width: 100%;
    height: 100%;
    padding: 3 2;
    content-align: center middle;
    text-align: center;
}

.user {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 2;
    border-left: thick $secondary;
    background: $boost;
    color: $foreground;
}

.assistant {
    height: auto;
    margin: 1 0 1 0;
    padding: 0 0 0 1;
    border-left: thick $accent 50%;
}

.assistant.failed {
    border-left: thick $error;
}

.assistant .who {
    height: 1;
    padding: 0 1;
}

.assistant .status {
    height: 1;
    padding: 0 1;
    display: none;
}

.assistant .answer {
    height: auto;
    margin: 0;
    padding: 0 1;
    background: transparent;
}

.assistant .answer > MarkdownParagraph,
.assistant .answer > MarkdownBulletList,
.assistant .answer > MarkdownOrderedList {
    margin: 0 0 1 0;
}

.assistant .sources {
    height: auto;
    padding: 0 1;
    margin-top: 0;
    display: none;
}

.assistant .meta {
    height: auto;
    padding: 0 1;
    margin-top: 1;
}

/* ---- prompt ------------------------------------------------------------ */

#menu {
    height: auto;
    max-height: 14;
    margin: 0 3;
    border: round $panel;
    background: $surface;
}

/* Welcome screen: float the menu just above the prompt rather than taking
   space from #chat, which would re-center (move) the logo as it opens/filters. */
#main.-welcome #menu {
    overlay: screen;
    offset-y: -100%;
}

/* Focus stays in the prompt while the menu is open, so OptionList would draw
   its faint "blurred" cursor; use the focused cursor so the active row shows. */
#menu > .option-list--option-highlighted {
    color: $block-cursor-foreground;
    background: $block-cursor-background;
    text-style: $block-cursor-text-style;
}

#prompt-box {
    height: auto;
    margin: 0 3;
    border: round $panel;
    padding: 0 1;
}

#prompt-box:focus-within {
    border: round $accent;
}

#prompt {
    height: auto;
    min-height: 1;
    max-height: 10;
    background: transparent;
    border: none;
}

#statusbar {
    height: 1;
    margin: 0 3 0 4;
}

#status-left {
    width: 1fr;
}

#status-right {
    width: auto;
}

/* ---- dialogs ----------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

.dialog.wide {
    width: 84;
}

.dialog .title {
    margin-bottom: 1;
}

.dialog .hint {
    margin-top: 1;
}

.dialog Input {
    margin-top: 1;
}

.dialog OptionList {
    height: auto;
    border: none;
    background: $surface;
}

/* ---- terminal themes ---------------------------------------------------
   The terminal's own background shows through; lines are dim gray and only
   accents carry color. */

#sidebar:ansi {
    border-right: vkey ansi_bright_black;
}

.user:ansi {
    border-left: outer $secondary;
}

.assistant:ansi {
    border-left: outer $accent;
}

#menu:ansi, #prompt-box:ansi, .dialog:ansi {
    border: round ansi_bright_black;
}

#prompt-box:ansi:focus-within, .dialog:ansi {
    border: round $accent;
}

CommandPalette:ansi #--input {
    border: hkey ansi_bright_black;
}

CommandPalette:ansi CommandList {
    border-bottom: hkey ansi_bright_black;
}

/* ---- notifications ---------------------------------------------------- */

/* Toasts sit in the top-right corner instead of Textual's bottom-right. */
ToastRack {
    dock: top;
    align: right top;
    margin-bottom: 0;
    margin-top: 1;
}

/* Plain notices take the theme's accent instead of the fixed success green;
   warnings and errors keep their own colors. */
Toast.-information {
    border-left: outer $accent;
}

Toast.-information .toast--title {
    color: $accent;
}
